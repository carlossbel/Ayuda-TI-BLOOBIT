# Copia este archivo como .env y pega los valores de tu proyecto Firebase
# (Consola Firebase > Configuración del proyecto > Tus apps > App web > SDK config)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=


# Notificaciones push: Firebase > Configuración del proyecto > Cloud Messaging > Certificados push web
VITE_FIREBASE_VAPID_KEY=

# SOLO EN VERCEL (no en este archivo): FIREBASE_SERVICE_ACCOUNT = contenido completo del JSON
# de Configuración del proyecto > Cuentas de servicio > Generar nueva clave privada
# SOLO EN VERCEL: USER_PASSWORDS = JSON con las contraseñas iniciales cifradas ({"usuario-id": "scrypt$..."})
