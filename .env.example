# Copia este archivo como .env y pega los valores de tu proyecto Firebase
# (Consola Firebase > Configuración del proyecto > Tus apps > App web > SDK config)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# PIN que se pide al entrar como administrador de TI (Carlos Beltran)
VITE_ADMIN_PIN=1234
